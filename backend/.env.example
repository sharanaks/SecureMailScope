# ---------------------------------------------------------
# SecureMailScope backend environment variables
# Copy this file to ".env" and fill in real values as needed.
# ---------------------------------------------------------

# JWT signing secret for the simple demo auth system.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret-for-your-demo

# JWT token lifetime, in minutes
JWT_EXPIRE_MINUTES=480

# SQLite database file path (relative to backend/ working directory)
DATABASE_PATH=./securemailscope.db

# ---------------------------------------------------------
# AI provider (OPTIONAL)
# If ANTHROPIC_API_KEY is not set, the backend automatically falls
# back to a deterministic, template-based explanation engine so the
# demo still works end-to-end without any API key.
# ---------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---------------------------------------------------------
# Blockchain (local Hardhat network)
# Defaults match a freshly started `npx hardhat node` instance.
# ---------------------------------------------------------
WEB3_PROVIDER_URI=http://127.0.0.1:8545
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# DKIM selectors to try when the user does not supply one (comma separated)
DKIM_COMMON_SELECTORS=default,selector1,selector2,google,k1,mail,dkim,smtp

# Frontend origin allowed for CORS
FRONTEND_ORIGIN=http://localhost:5173
